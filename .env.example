# ============================================================================
# ViralScope AI — variáveis de ambiente de referência
# Copie para .env na raiz (docker-compose) e/ou apps/web/.env.local e
# apps/api/.env conforme o app. Nunca commite o .env real.
# ============================================================================

# ---------------------------------------------------------------------------
# App / ambiente
# ---------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Frontend (apps/web) — expostas ao browser precisam do prefixo NEXT_PUBLIC_
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (apps/api)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Banco de dados — local (docker-compose) aponta para o Postgres do compose;
# em staging/prod, aponta para o Supabase Postgres.
# IMPORTANTE: use a connection string do "Connection Pooling" do Supabase
# (Settings → Database → Connection Pooling, modo Transaction/porta 6543 ou Session/5432),
# não a "Connection string" direta (db.<ref>.supabase.co) — essa é IPv6-only e falha em redes
# sem rota IPv6. O usuário do pooler tem o formato postgres.<project-ref>, não só "postgres".
DATABASE_URL=postgresql+asyncpg://viralscope:viralscope@localhost:5432/viralscope

# Supabase (staging/prod)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (cache + fila de jobs assíncronos de transcrição/IA)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Autenticação — Clerk
# apps/web: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY
# apps/api: CLERK_JWKS_URL + CLERK_ISSUER + CLERK_WEBHOOK_SECRET
# Passo a passo em apps/web/README.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Pagamentos — Stripe (adicionado no Módulo 6)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# IA — Claude / OpenAI / Whisper (adicionado no Módulo 5)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# YouTube Data API (ingestão — Módulo 4)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
